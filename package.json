{
  "name": "solar-system",
  "version": "0.1.0",
  "description": "A classroom page that shows where the Sun and planets really are, at true scale, calculated from NASA JPL's DE440 data and checked against JPL Horizons.",
  "license": "MIT",
  "author": "Mike Zupper",
  "homepage": "https://github.com/mikezupper/learn-solar-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikezupper/learn-solar-system.git"
  },
  "bugs": {
    "url": "https://github.com/mikezupper/learn-solar-system/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "harness": "tsx tools/harness/src/main.ts",
    "bootstrap": "git submodule update --init --recursive && pnpm install",
    "dev": "pnpm harness dev",
    "dev:quick": "TILE_STORE_DIR=fixtures/tiles pnpm --filter @solar/web dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:layers": "pnpm harness lint-layers",
    "lint:docs": "pnpm harness lint-docs",
    "lint:freshness": "pnpm harness lint-freshness",
    "lint:taste": "pnpm harness lint-taste",
    "gen-docs": "pnpm harness gen-docs",
    "quality": "pnpm harness quality",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:kernel": "vitest run --project kernel",
    "coverage": "vitest run --project unit --coverage",
    "tiles:build": "tsx apps/worker/src/main.ts",
    "build": "pnpm --filter @solar/web build",
    "e2e": "pnpm --filter @solar/web e2e",
    "obs:up": "pnpm harness obs up",
    "obs:down": "pnpm harness obs down",
    "obs:logs": "pnpm harness obs logs",
    "obs:metrics": "pnpm harness obs metrics",
    "obs:traces": "pnpm harness obs traces",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:layers && pnpm lint:docs && pnpm lint:taste && pnpm gen-docs --check && pnpm quality --check && pnpm coverage && pnpm test:browser && pnpm build && pnpm budget && pnpm e2e",
    "budget": "pnpm harness budget",
    "obs:check": "pnpm harness obs check",
    "verify:full": "pnpm verify && pnpm lint:freshness && pnpm test:kernel && pnpm obs:check",
    "dev:stop": "pnpm harness stop"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "10.14.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1",
    "vitest": "catalog:",
    "@gyral/core": "catalog:"
  }
}
