# Copy this file to .env, which git ignores, and keep real hostnames there.

# Names the dev and preview servers answer to, besides localhost, separated by commas.
# Start a name with a dot to allow a domain and all of its subdomains: .example.com
ALLOWED_HOSTS=

# Where deploy/build-image.sh pushes the production image: the registry's push address, and the namespace inside it.
# The image becomes <IMAGE_REGISTRY>/<IMAGE_NAMESPACE>/learn-solar-system. Only --push needs these.
# IMAGE_NAME, IMAGE_PLATFORMS and TILE_YEARS may be set here too; `deploy/build-image.sh --help` lists their defaults.
IMAGE_REGISTRY=
IMAGE_NAMESPACE=
