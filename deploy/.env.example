# Settings for deploy/compose.yaml on the server. Copy this file to .env beside compose.yaml.
# Git ignores .env, so the registry's real address stays out of the repository.

# The image to run, without a tag: the registry's pull address, the namespace, and learn-solar-system.
IMAGE_REPOSITORY=registry.example.com/namespace/learn-solar-system

# Which release to run. A sha-<commit> tag pins one, so that a rollback is a one-line change.
# latest follows every push.
IMAGE_TAG=latest

# Where the site answers plain HTTP on the server. 127.0.0.1 keeps it off the network, for a proxy
# or tunnel on the same server. A proxy or tunnel in a container reaches it with network_mode: host,
# since a container's own 127.0.0.1 is not the server's.
SITE_ADDRESS=127.0.0.1
SITE_PORT=8080
